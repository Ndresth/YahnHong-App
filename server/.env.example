# Conexión a MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/yahnhong

# Secreto para firmar sesiones. Mínimo 32 caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Claves de acceso por rol (use claves distintas y largas)
ADMIN_PASSWORD=
CAJERO_PASSWORD=
MESERA_PASSWORD=
# Opcional: rol que sólo ve la pantalla de cocina
COCINA_PASSWORD=

# Opcional: sólo si el frontend se sirve desde OTRO dominio (separado por comas)
# CORS_ORIGIN=https://yahnhong-app.onrender.com
